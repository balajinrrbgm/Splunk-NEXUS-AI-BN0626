# =============================================================================
# Splunk Nexus AI - Environment Configuration
# =============================================================================

# LLM Provider
GOOGLE_API_KEY=your-gemini-api-key
LLM_PROVIDER=google              # google | openai | anthropic
LLM_MODEL=gemini-2.5-flash

# Splunk MCP
SPLUNK_HOST=https://localhost:8089
SPLUNK_TOKEN=your-splunk-hec-token
SPLUNK_MCP_MODE=mock              # mock | live
SPLUNK_INDEX=main

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus-ai-2026

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=nexus-incidents

# PostgreSQL (LangGraph State)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_ai
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus-ai-2026

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=Splunk Nexus AI

# Demo Mode
DEMO_MODE_ENABLED=true
DEMO_DURATION_SECONDS=180
