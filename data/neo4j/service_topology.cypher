// Neo4j Cypher - Service Topology
// Creates a 20-node service mesh with realistic dependencies

// ── Create Service Nodes ──
CREATE (cdn:Service {id: 'cdn-edge', name: 'CDN Edge', type: 'gateway', team: 'Platform Team'})
CREATE (nginx:Service {id: 'nginx-lb', name: 'Nginx LB', type: 'gateway', team: 'Platform Team'})
CREATE (gw:Service {id: 'api-gateway', name: 'API Gateway', type: 'gateway', team: 'Platform Team'})
CREATE (auth:Service {id: 'auth-service', name: 'Auth Service', type: 'api', team: 'Identity Team'})
CREATE (user:Service {id: 'user-service', name: 'User Service', type: 'api', team: 'User Team'})
CREATE (order:Service {id: 'order-service', name: 'Order Service', type: 'api', team: 'Commerce Team'})
CREATE (pay:Service {id: 'payment-service', name: 'Payment Service', type: 'api', team: 'Payments Team'})
CREATE (inv:Service {id: 'inventory-service', name: 'Inventory Service', type: 'api', team: 'Supply Chain Team'})
CREATE (notif:Service {id: 'notification-service', name: 'Notification Service', type: 'api', team: 'Engagement Team'})
CREATE (analytics:Service {id: 'analytics-engine', name: 'Analytics Engine', type: 'api', team: 'Data Team'})
CREATE (search:Service {id: 'search-service', name: 'Search Service', type: 'api', team: 'Search Team'})
CREATE (pg1:Service {id: 'postgres-primary', name: 'PostgreSQL Primary', type: 'database', team: 'DBA Team'})
CREATE (pg2:Service {id: 'postgres-replica', name: 'PostgreSQL Replica', type: 'database', team: 'DBA Team'})
CREATE (redis:Service {id: 'redis-cache', name: 'Redis Cache', type: 'cache', team: 'Platform Team'})
CREATE (es:Service {id: 'elasticsearch', name: 'Elasticsearch', type: 'database', team: 'Search Team'})
CREATE (k1:Service {id: 'kafka-broker-1', name: 'Kafka Broker 1', type: 'queue', team: 'Data Team'})
CREATE (k2:Service {id: 'kafka-broker-2', name: 'Kafka Broker 2', type: 'queue', team: 'Data Team'})
CREATE (consul:Service {id: 'consul-registry', name: 'Consul Registry', type: 'api', team: 'Platform Team'})
CREATE (vault:Service {id: 'vault-secrets', name: 'Vault Secrets', type: 'api', team: 'Security Team'})
CREATE (grafana:Service {id: 'grafana-monitor', name: 'Grafana Monitor', type: 'api', team: 'SRE Team'})

// ── Create Dependency Edges ──
CREATE (cdn)-[:DEPENDS_ON {protocol: 'https', latency_ms: 2}]->(nginx)
CREATE (nginx)-[:DEPENDS_ON {protocol: 'http', latency_ms: 1}]->(gw)
CREATE (gw)-[:DEPENDS_ON {protocol: 'grpc', latency_ms: 5}]->(auth)
CREATE (gw)-[:DEPENDS_ON {protocol: 'grpc', latency_ms: 8}]->(user)
CREATE (gw)-[:DEPENDS_ON {protocol: 'grpc', latency_ms: 15}]->(order)
CREATE (gw)-[:DEPENDS_ON {protocol: 'grpc', latency_ms: 10}]->(search)
CREATE (order)-[:DEPENDS_ON {protocol: 'grpc', latency_ms: 45}]->(pay)
CREATE (order)-[:DEPENDS_ON {protocol: 'grpc', latency_ms: 12}]->(inv)
CREATE (order)-[:DEPENDS_ON {protocol: 'grpc', latency_ms: 8}]->(notif)
CREATE (user)-[:DEPENDS_ON {protocol: 'jdbc', latency_ms: 3}]->(pg1)
CREATE (order)-[:DEPENDS_ON {protocol: 'jdbc', latency_ms: 4}]->(pg1)
CREATE (pay)-[:DEPENDS_ON {protocol: 'jdbc', latency_ms: 3}]->(pg1)
CREATE (pg1)-[:REPLICATES_TO {lag_ms: 1}]->(pg2)
CREATE (auth)-[:DEPENDS_ON {protocol: 'redis', latency_ms: 1}]->(redis)
CREATE (search)-[:DEPENDS_ON {protocol: 'http', latency_ms: 10}]->(es)
CREATE (notif)-[:DEPENDS_ON {protocol: 'kafka', latency_ms: 2}]->(k1)
CREATE (analytics)-[:DEPENDS_ON {protocol: 'kafka', latency_ms: 3}]->(k1)
CREATE (k1)-[:REPLICATES_TO {lag_ms: 1}]->(k2)
CREATE (gw)-[:DEPENDS_ON {protocol: 'http', latency_ms: 2}]->(consul)
CREATE (auth)-[:DEPENDS_ON {protocol: 'https', latency_ms: 5}]->(vault);
